# Password protection for the flagship case study (/work/ownership-and-progress).
# Copy this file to .env.local for local development and set real values.
# In production, set both in your host's environment settings. Never commit real values.

# The password visitors type. Pick something long and unique.
CASE_STUDY_PASSWORD=

# A random secret used to sign the access cookie (at least 32 characters).
# Generate one with:  openssl rand -base64 48
CASE_STUDY_SESSION_SECRET=
